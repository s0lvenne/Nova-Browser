<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>NovaBrowser</AssemblyName>
    <RootNamespace>NovaBrowser</RootNamespace>
    <ApplicationIcon>nova_1.ico</ApplicationIcon>
    <Company>Nova</Company>
    <Product>Nova Browser</Product>
    <Description>Nova Browser — fast, secure, customizable</Description>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Copyright>© 2026 Nova</Copyright>
    <AllowUnsafeBlocks>False</AllowUnsafeBlocks>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <PackageIcon>nova_icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\nova.ico" />
    <Resource Include="Assets\Icons\**\*" Condition="Exists('Assets\Icons')" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="nova_1.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="nova_icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="wallpaper-default.jpg" Condition="Exists('wallpaper-default.jpg')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Home\**\*" Condition="Exists('Assets\Home')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.*" />
  </ItemGroup>
</Project>
