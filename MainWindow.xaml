            </Popup>
            
            <Popup x:Name="ZoomPopup" StaysOpen="False" AllowsTransparency="True"
                   PlacementTarget="{Binding ElementName=MenuButton}" Placement="Bottom" PopupAnimation="Fade"
                   Grid.Row="1">
                <Border Background="{DynamicResource PopupBrush}" CornerRadius="10" Padding="12,8"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Width="220">
                    <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.5" Color="Black"/></Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Масштаб" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ZoomOutBtn" Content="−" Style="{DynamicResource NavButton}"
                                    Width="32" Height="32" Click="ZoomOut_Click" FontSize="16"/>
                            <TextBlock x:Name="ZoomLabel" Grid.Column="1" Text="100%"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold"/>
                            <Button x:Name="ZoomInBtn" Grid.Column="2" Content="+" Style="{DynamicResource NavButton}"
                                    Width="32" Height="32" Click="ZoomIn_Click" FontSize="16"/>
                            <Button Grid.Column="3" Content="" Style="{DynamicResource NavButton}"
                                    Width="32" Height="32" Click="ZoomReset_Click" FontSize="13"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Popup>
            
            <Grid x:Name="StatusBarGrid" Grid.Row="5" Background="{DynamicResource TitleBarBrush}" Height="26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Готов" FontSize="11" Margin="14,0" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" FontFamily="{DynamicResource MainFont}"/>
                <TextBlock x:Name="ProxyIndicator" Grid.Column="1" Text="[ Прокси ]" FontSize="11" Margin="8,0" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Cursor="Hand" FontFamily="{DynamicResource MainFont}" Visibility="Collapsed"/>
                <TextBlock x:Name="PrivateIndicator" Grid.Column="2" Text="[ Приватный ]" FontSize="11" Margin="8,0" Foreground="{DynamicResource AccentOrangeBrush}" VerticalAlignment="Center" FontFamily="{DynamicResource MainFont}" Visibility="Collapsed"/>
                <TextBlock Grid.Column="3" Text="Защита" FontSize="11" Margin="8,0" Foreground="{DynamicResource AccentGreenBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="MemoryUsage" Grid.Column="4" FontSize="11" Margin="8,0,14,0" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" FontFamily="{DynamicResource MainFont}"/>
            </Grid>
            <Rectangle x:Name="ResizeTop" Grid.Row="0" VerticalAlignment="Top" Height="6" Cursor="SizeNS" Fill="Transparent" PreviewMouseLeftButtonDown="ResizeBorder_MouseDown" Tag="Top" Panel.ZIndex="5000"/>
            <Rectangle x:Name="ResizeBottom" Grid.Row="5" VerticalAlignment="Bottom" Height="6" Cursor="SizeNS" Fill="Transparent" PreviewMouseLeftButtonDown="ResizeBorder_MouseDown" Tag="Bottom" Panel.ZIndex="5000"/>
            <Rectangle x:Name="ResizeLeft" Grid.RowSpan="6" HorizontalAlignment="Left" Width="6" Cursor="SizeWE" Fill="Transparent" PreviewMouseLeftButtonDown="ResizeBorder_MouseDown" Tag="Left" Panel.ZIndex="5000"/>
            <Rectangle x:Name="ResizeRight" Grid.RowSpan="6" HorizontalAlignment="Right" Width="6" Cursor="SizeWE" Fill="Transparent" PreviewMouseLeftButtonDown="ResizeBorder_MouseDown" Tag="Right" Panel.ZIndex="5000"/>
            <Rectangle x:Name="ResizeTopLeft" Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="12" Height="12" Cursor="SizeNWSE" Fill="Transparent" PreviewMouseLeftButtonDown="ResizeBorder_MouseDown" Tag="TopLeft" Panel.ZIndex="5001"/>
            <Rectangle x:Name="ResizeTopRight" Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Right" Width="12" Height="12" Cursor="SizeNESW" Fill="Transparent" PreviewMouseLeftButtonDown="ResizeBorder_MouseDown" Tag="TopRight" Panel.ZIndex="5001"/>
            <Rectangle x:Name="ResizeBottomLeft" Grid.Row="5" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="12" Height="12" Cursor="SizeNESW" Fill="Transparent" PreviewMouseLeftButtonDown="ResizeBorder_MouseDown" Tag="BottomLeft" Panel.ZIndex="5001"/>
            <Rectangle x:Name="ResizeBottomRight" Grid.Row="5" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="12" Height="12" Cursor="SizeNWSE" Fill="Transparent" PreviewMouseLeftButtonDown="ResizeBorder_MouseDown" Tag="BottomRight" Panel.ZIndex="5001"/>
            <Thumb Grid.Row="5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="16" Height="16" Cursor="SizeNWSE" Opacity="0" DragDelta="ResizeGrip_DragDelta"/>
