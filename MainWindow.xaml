<Window x:Class="NovaBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Nova Browser" Width="1300" Height="850" MinWidth="800" MinHeight="500"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closing="MainWindow_Closing"
        Icon="Assets/nova.ico">
    <Border x:Name="MainBorder" Background="{DynamicResource BgDarkBrush}" CornerRadius="12" Margin="6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.6" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <Grid x:Name="TitleBarGrid" Grid.Row="0" Background="{DynamicResource TitleBarBrush}"
                  MouseLeftButtonDown="TitleBar_MouseDown"
                  PreviewMouseLeftButtonDown="TitleBar_PreviewMouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,7,8,5">
                    <TextBlock x:Name="LogoIcon" Text="" FontSize="20" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect x:Name="LogoGlow" BlurRadius="12" ShadowDepth="0" Color="{DynamicResource AccentColor}" Opacity="0.5"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock x:Name="LogoText" Text=" NOVA" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="4,0,0,0" FontFamily="{DynamicResource MainFont}" Opacity="0.7"/>
                </StackPanel>
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="TabScroll_PreviewMouseWheel">
                    <StackPanel x:Name="TabsPanel" Orientation="Horizontal" Margin="0,4,0,0"/>
                </ScrollViewer>
                <Button Grid.Column="2" Style="{DynamicResource NewTabButton}" Click="NewTab_Click" Margin="6,6,8,6"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets" Style="{DynamicResource WindowControlButton}" Click="Minimize_Click"/>
                    <Button x:Name="MaximizeButton" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" Style="{DynamicResource WindowControlButton}" Click="Maximize_Click"/>
                    <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Style="{DynamicResource CloseButton}" Click="Close_Click"/>
                </StackPanel>
            </Grid>
            
            <Grid x:Name="NavBarGrid" Grid.Row="1" Background="{DynamicResource BgCardBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Grid.Column="0" Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" Style="{DynamicResource NavButton}" Click="Back_Click" Margin="8,5,0,5"/>
                <Button x:Name="ForwardButton" Grid.Column="1" Content="&#xE72A;" FontFamily="Segoe MDL2 Assets" Style="{DynamicResource NavButton}" Click="Forward_Click" Margin="2,5"/>
                <Button Grid.Column="2" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" Style="{DynamicResource NavButton}" Click="Refresh_Click" Margin="0,5,2,5"/>
                <Button Grid.Column="3" Content="&#xE80F;" FontFamily="Segoe MDL2 Assets" Style="{DynamicResource NavButton}" Click="Home_Click" Margin="0,5,6,5"/>
                <Grid Grid.Column="4" Margin="0,5">
                    <TextBox x:Name="AddressBox" Style="{DynamicResource AddressBar}" KeyDown="AddressBox_KeyDown" GotFocus="AddressBox_GotFocus" TextChanged="AddressBox_TextChanged"/>
                    <TextBlock x:Name="AddressPlaceholder" Text="Поиск в интернете или адрес сайта..." Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False" FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=AddressBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Popup x:Name="SuggestPopup" PlacementTarget="{Binding ElementName=AddressBox}" Placement="Bottom"
                           StaysOpen="False" Focusable="False" AllowsTransparency="True" Width="{Binding ActualWidth, ElementName=AddressBox}">
                        <Border Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="0,0,8,8" Padding="4">
                            <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.4" Color="Black"/></Border.Effect>
                            <ListBox x:Name="SuggestList" Background="Transparent" BorderThickness="0"
                                     SelectionChanged="Suggest_SelectionChanged" MouseLeftButtonUp="Suggest_Click"
                                     MaxHeight="220" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Url}"   Foreground="{DynamicResource TextMutedBrush}"    FontSize="10" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding"    Value="10,6"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource BgHoverBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Border>
                    </Popup>
                </Grid>
                <Button x:Name="SecurityButton" Grid.Column="5" Style="{DynamicResource NavButton}" Click="Security_Click" Margin="4,5,2,5" Content="&#xE72E;" FontFamily="{DynamicResource IconFont}" FontSize="13" Foreground="{DynamicResource AccentGreenBrush}"/>
                <Button x:Name="MuteButton" Grid.Column="6" Content="&#xE767;" FontFamily="{DynamicResource IconFont}" Style="{DynamicResource NavButton}" Click="Mute_Click" Margin="0,5,2,5" FontSize="13" Visibility="Collapsed"/>
                <Button Grid.Column="7" Content="&#xE728;" FontFamily="Segoe MDL2 Assets" Style="{DynamicResource NavButton}" Click="AddBookmark_Click" Margin="0,5,2,5"/>
                <Button x:Name="DownloadsNavBtn" Grid.Column="8" Content="&#xE896;" FontFamily="Segoe MDL2 Assets" Style="{DynamicResource NavButton}" Click="MenuDownloads_Click" PreviewMouseLeftButtonDown="DownloadsNavBtn_PreviewMouseLeftButtonDown" Margin="0,5,2,5" FontSize="13"/>
                <Button Grid.Column="9" Content="&#xE713;" FontFamily="Segoe MDL2 Assets" Style="{DynamicResource NavButton}" Click="Settings_Click" Margin="0,5,2,5"/>
                <Button x:Name="MenuButton" Grid.Column="10" Content="&#xE712;" FontFamily="Segoe MDL2 Assets" Style="{DynamicResource NavButton}" Click="Menu_Click" Margin="0,5,8,5" FontSize="13"/>
            </Grid>
            
            <Grid x:Name="BookmarksBar" Grid.Row="2" Background="{DynamicResource BookmarksBarBrush}" MinHeight="0">
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="BookmarksPanel" Orientation="Horizontal" Margin="12,3"/>
                </ScrollViewer>
            </Grid>
            
            <Rectangle Grid.Row="3" Fill="{DynamicResource GlowLine}" Height="1" Opacity="0.5"/>
            <ProgressBar x:Name="LoadingBar" Grid.Row="3" Height="2" Background="Transparent" Foreground="{DynamicResource AccentBrush}" BorderThickness="0" IsIndeterminate="True" Visibility="Collapsed"/>
            
            <Grid Grid.Row="4" Background="{DynamicResource BgDarkBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition x:Name="DevToolsSplitterRow" Height="Auto"/>
                    <RowDefinition x:Name="DevToolsRow" Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                <Grid x:Name="WebViewContainer" Panel.ZIndex="1"/>
                
                <Grid x:Name="BlockedPage" Visibility="Collapsed" Background="{DynamicResource BgDarkBrush}" Panel.ZIndex="10">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE7BA;" FontFamily="{DynamicResource IconFont}" FontSize="72" HorizontalAlignment="Center" Foreground="{DynamicResource AccentOrangeBrush}"/>
                        <TextBlock x:Name="BlockedTitle" Text="Страница заблокирована" FontSize="26" FontWeight="Bold" Margin="0,20,0,10" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" FontFamily="{DynamicResource MainFont}"/>
                        <TextBlock x:Name="BlockedReason" FontSize="{DynamicResource UiFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="500" TextAlignment="Center"/>
                        <Button Content="← Назад" Margin="0,28,0,0" Style="{DynamicResource NavButton}" Width="120" Height="42" FontFamily="{DynamicResource MainFont}" FontSize="{DynamicResource UiFontSize}" Foreground="{DynamicResource AccentBrush}" Click="Back_Click"/>
                    </StackPanel>
                </Grid>
                
                <Grid x:Name="WallpaperLayer" Visibility="Collapsed" Panel.ZIndex="4"
                      Background="{DynamicResource BgDarkBrush}">
                    
                    <Canvas x:Name="AnimWallpaperCanvas" ClipToBounds="True">
                        
                        <Ellipse x:Name="Blob1" Width="600" Height="600" Opacity="0.18"
                                 Canvas.Left="-100" Canvas.Top="-150">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop x:Name="Blob1Stop1" Color="#BEF47B" Offset="0"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        
                        <Ellipse x:Name="Blob2" Width="500" Height="500" Opacity="0.15"
                                 Canvas.Left="600" Canvas.Top="200">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop x:Name="Blob2Stop1" Color="#7B2FFF" Offset="0"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        
                        <Ellipse x:Name="Blob3" Width="450" Height="450" Opacity="0.12"
                                 Canvas.Left="300" Canvas.Top="350">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop x:Name="Blob3Stop1" Color="#00FFB3" Offset="0"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        
                        <Ellipse x:Name="Blob4" Width="300" Height="300" Opacity="0.10"
                                 Canvas.Left="900" Canvas.Top="-50">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop x:Name="Blob4Stop1" Color="#FF6B6B" Offset="0"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                    </Canvas>
                    
                    <MediaElement x:Name="LiveWallpaperVideo"
                                  Stretch="UniformToFill"
                                  LoadedBehavior="Manual"
                                  UnloadedBehavior="Stop"
                                  IsMuted="True"
                                  Visibility="Collapsed"
                                  MediaEnded="LiveWallpaper_MediaEnded"/>
                    <Image x:Name="WallpaperImage" Stretch="UniformToFill"/>
                    <Rectangle x:Name="WallpaperOverlay">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                <GradientStop Color="#990A0A0F" Offset="0"/>
                                <GradientStop Color="#330A0A0F" Offset="0.5"/>
                                <GradientStop Color="#990A0A0F" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>
                
                <Grid x:Name="HomePage" Visibility="Collapsed" Panel.ZIndex="10"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Grid.Background>
                        <SolidColorBrush x:Name="HomePageBgBrush" Color="#0C0C0C"/>
                    </Grid.Background>
                    
                    <Image x:Name="HomeBgImage" Stretch="UniformToFill"
                           IsHitTestVisible="False" Visibility="Collapsed"/>
                    
                    <Canvas x:Name="HomeBlobCanvas" IsHitTestVisible="False">
                        <Ellipse x:Name="HomeBlob1" Width="520" Height="520"
                                 Canvas.Left="-120" Canvas.Top="-130" Opacity="0.13"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="HomeBlob1Move"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse x:Name="HomeBlob2" Width="480" Height="480"
                                 Canvas.Right="-100" Canvas.Bottom="-100" Opacity="0.12"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="HomeBlob2Move"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#003322" Offset="0"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse x:Name="HomeBlob3" Width="320" Height="320"
                                 Canvas.Left="500" Canvas.Top="350" Opacity="0.10"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="HomeBlob3Move"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#000833" Offset="0"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Canvas.Triggers>
                            <EventTrigger RoutedEvent="Canvas.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        
                                        <DoubleAnimation Storyboard.TargetName="HomeBlob1Move" Storyboard.TargetProperty="X"
                                                         From="0" To="60" Duration="0:0:14" AutoReverse="True">
                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HomeBlob1Move" Storyboard.TargetProperty="Y"
                                                         From="0" To="40" Duration="0:0:18" AutoReverse="True">
                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HomeBlob1" Storyboard.TargetProperty="Opacity"
                                                         From="0.10" To="0.17" Duration="0:0:9" AutoReverse="True"/>
                                        
                                        <DoubleAnimation Storyboard.TargetName="HomeBlob2Move" Storyboard.TargetProperty="X"
                                                         From="0" To="-50" Duration="0:0:16" AutoReverse="True">
                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HomeBlob2Move" Storyboard.TargetProperty="Y"
                                                         From="0" To="-35" Duration="0:0:12" AutoReverse="True">
                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HomeBlob2" Storyboard.TargetProperty="Opacity"
                                                         From="0.08" To="0.15" Duration="0:0:11" AutoReverse="True"/>
                                        
                                        <DoubleAnimation Storyboard.TargetName="HomeBlob3Move" Storyboard.TargetProperty="X"
                                                         From="-30" To="30" Duration="0:0:13" AutoReverse="True">
                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HomeBlob3Move" Storyboard.TargetProperty="Y"
                                                         From="20" To="-20" Duration="0:0:17" AutoReverse="True">
                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HomeBlob3" Storyboard.TargetProperty="Opacity"
                                                         From="0.07" To="0.13" Duration="0:0:10" AutoReverse="True"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Canvas.Triggers>
                    </Canvas>
                    
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                MinWidth="600" Margin="0,-40,0,0">
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                    Margin="0,0,0,36">
                            <Border Width="46" Height="46" Margin="0,0,16,2"
                                    Background="{DynamicResource AccentBrush}">
                                <Border.RenderTransform>
                                    <RotateTransform Angle="45" CenterX="23" CenterY="23"/>
                                </Border.RenderTransform>
                                <Border.Effect>
                                    <DropShadowEffect Color="{DynamicResource AccentColor}"
                                                      BlurRadius="24" ShadowDepth="0" Opacity="0.85"/>
                                </Border.Effect>
                            </Border>
                            <TextBlock x:Name="HomeLogoText"
                                       Text="NOVA" FontSize="40" FontWeight="Black"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontFamily="{DynamicResource MainFont}"
                                       VerticalAlignment="Center">
                                <TextBlock.Effect>
                                    <DropShadowEffect x:Name="HomeLogoGlow"
                                                      Color="{DynamicResource AccentColor}"
                                                      BlurRadius="30" ShadowDepth="0" Opacity="0.5"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </StackPanel>
                        
                        <Border x:Name="HomeSearchBorder"
                                CornerRadius="28" Margin="0,0,0,22"
                                Background="{DynamicResource BgCardBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                Padding="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Text="&#x1F50D;" FontFamily="Segoe UI Emoji, Segoe UI Symbol, Segoe UI"
                                           FontSize="15" Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Opacity="0.55"/>
                                
                                <Grid Grid.Column="1">
                                    <TextBox x:Name="HomeSearchBox"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             CaretBrush="{DynamicResource AccentBrush}"
                                             FontSize="16" FontFamily="{DynamicResource MainFont}"
                                             Padding="0,14" VerticalContentAlignment="Center"
                                             KeyDown="HomeSearch_KeyDown"/>
                                    <TextBlock Text="Поиск или адрес сайта..."
                                               FontSize="16" FontFamily="{DynamicResource MainFont}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center" Margin="2,0,0,0"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=HomeSearchBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                
                                <Button Grid.Column="2" Content="Найти"
                                        Background="{DynamicResource AccentBrush}"
                                        Foreground="#000000" FontWeight="SemiBold"
                                        FontSize="14" FontFamily="{DynamicResource MainFont}"
                                        Padding="22,0" Height="38" Margin="6"
                                        BorderThickness="0" Cursor="Hand"
                                        Click="HomeSearchBtn_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBg"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="22"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="btnBg" Property="Opacity" Value="0.82"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>
                        
                        <WrapPanel x:Name="HomeQuickLinksPanel" HorizontalAlignment="Center"/>
                    </StackPanel>
                    
                    <TextBlock x:Name="HomeGreetingText" Text=""
                               VerticalAlignment="Bottom" HorizontalAlignment="Right"
                               Margin="0,0,24,16" FontSize="12" Opacity="0.38"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontFamily="{DynamicResource MainFont}"/>
                </Grid>
                
                
                <Grid x:Name="SettingsPage" Visibility="Collapsed" Background="{DynamicResource BgDarkBrush}" Panel.ZIndex="8"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Border Grid.Column="0" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                        <StackPanel Margin="8,20,8,0">
                            <TextBlock Text="Настройки" FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontFamily="{DynamicResource MainFont}"
                                       Margin="10,0,0,20"/>
                            <Button x:Name="TabBtnGeneral"     Content="Общие"           Style="{DynamicResource SettingsTabBtnActive}" Click="SettingsTab_Click" Tag="General"      Margin="0,2"/>
                            <Button x:Name="TabBtnSecurity"    Content="Безопасность"    Style="{DynamicResource SettingsTabBtn}"       Click="SettingsTab_Click" Tag="Security"     Margin="0,2"/>
                            <Button x:Name="TabBtnAppearance"  Content="Внешний вид"     Style="{DynamicResource SettingsTabBtn}"       Click="SettingsTab_Click" Tag="Appearance"   Margin="0,2"/>
                            <Button x:Name="TabBtnAccess"      Content="Спец. возможности" Style="{DynamicResource SettingsTabBtn}"    Click="SettingsTab_Click" Tag="Access"       Margin="0,2"/>
                            <Button x:Name="TabBtnDownloads"   Content="Загрузки"           Style="{DynamicResource SettingsTabBtn}"    Click="SettingsTab_Click" Tag="Downloads"    Margin="0,2"/>
                            <Button x:Name="TabBtnPerf"        Content="Производительность" Style="{DynamicResource SettingsTabBtn}"    Click="SettingsTab_Click" Tag="Perf"         Margin="0,2"/>
                            <Button x:Name="TabBtnAdvanced"    Content="Дополнительно"      Style="{DynamicResource SettingsTabBtn}"    Click="SettingsTab_Click" Tag="Advanced"     Margin="0,2"/>
                            <Separator Background="{DynamicResource BorderBrush}" Margin="8,16"/>
                            <Button Content=" Применить настройки" Click="ApplySettingsBtn_Click"
                                    Background="{DynamicResource AccentBrush}" Foreground="#000000"
                                    FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                                    FontFamily="{DynamicResource MainFont}" FontSize="13"
                                    Padding="10,9" Margin="2,8,2,8" HorizontalContentAlignment="Center">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Content="Очистить данные" Click="ClearData_Click" Style="{DynamicResource SettingsTabBtn}" Foreground="{DynamicResource AccentRedBrush}" Margin="0,2"/>
                            <Button Content="&lt;&lt; Закрыть"          Click="CloseSettings_Click"  Style="{DynamicResource SettingsTabBtn}" Foreground="{DynamicResource AccentBrush}" Margin="0,2"/>
                        </StackPanel>
                    </Border>
                    
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0,10">
                        <StackPanel Margin="32,10,32,30">
                            
                            <StackPanel x:Name="TabGeneral" Visibility="Visible">
                                <TextBlock Text="Общие" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource MainFont}" Margin="0,0,0,20"/>
                                <Border Background="{DynamicResource BgSurfaceBrush}" CornerRadius="12" Padding="20,16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Поисковая система" FontSize="{DynamicResource UiFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                                        <ComboBox x:Name="SearchEngineCombo" FontSize="{DynamicResource UiFontSizeSm}" Padding="10,7" SelectionChanged="SearchEngine_Changed">
                                            <ComboBoxItem Content="Nova"         IsSelected="True"/>
                                            <ComboBoxItem Content="Google"/>
